  {colosseum(accent)}
  {icon(c["icon"], accent)}
</svg>
'''


def main() -> None:
    for c in COVERS:
        path = OUT / f'{c["file"]}.svg'
        path.write_text(cover(c), encoding="utf-8")
        print(path)


if __name__ == "__main__":
    main()
