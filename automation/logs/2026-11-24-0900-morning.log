import urllib.request, xml.etree.ElementTree as ET, re
def feed(u, n=25):
    req=urllib.request.Request(u,headers={'User-Agent':'Mozilla/5.0'})
    d=urllib.request.urlopen(req,timeout=25).read()
    r=ET.fromstring(d)
    print("="*10,u)
    for it in list(r.iter('item'))[:n]:
        t=it.findtext('title'); l=it.findtext('link'); p=it.findtext('pubDate')
        print("-",re.sub(r'\s+',' ',t or '')[:150],"|",p,"|",l)
feed("https://www.romatoday.it/rss")
EOF
