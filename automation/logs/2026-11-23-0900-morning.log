def colosseum(accent: str) -> str:
    # декоративні арки праворуч знизу
    parts = [f'<g opacity="0.10" fill="none" stroke="{accent}" stroke-width="4">']
    for i in range(6):
        x = 690 + i * 64
        parts.append(f'<path d="M{x} 790 L{x} 742 Q{x+22} 716 {x+44} 742 L{x+44} 790"/>')
    parts.append('</g>')
    return "".join(parts)


